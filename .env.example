# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (SQLAlchemy + psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/studyvault

# Secret used to sign JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me

# Token lifetimes (optional; these are the defaults)
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google Gemini API key (embeddings + answer/flashcard/quiz generation)
GEMINI_API_KEY=your-gemini-api-key
