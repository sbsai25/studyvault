# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (SQLAlchemy + psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/studyvault

# Secret used to sign JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me

# Token lifetimes (optional; these are the defaults)
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google Gemini API key (embeddings + answer/flashcard/fill-in-the-blank generation)
GEMINI_API_KEY=your-gemini-api-key

# Separate database used ONLY by pytest. Its name must end in "_test" and it must
# be on localhost (the test suite drops and recreates every table in it).
TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/studyvault_test
# Must be 1 before pytest will reset the test database (a deliberate opt-in)
ALLOW_TEST_DB_RESET=1

# Optional settings (defaults shown)
# Gemini model for answers, titles and study material. Each model has its own
# free-tier quota; list the models your key can use with client.models.list().
GEMINI_MODEL=gemini-3.5-flash-lite
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
# Maximum upload size in megabytes
MAX_UPLOAD_MB=20
# Where ChromaDB and uploaded files are stored (default: .chroma/ and uploads/ in the project root)
# CHROMA_PATH=
# UPLOAD_DIR=
